# Local PostgreSQL defaults; never place production secrets in this file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

AUTH_DATABASE_URL=postgres://postgres:postgres@postgres:5432/auth?sslmode=disable
TASKS_DATABASE_URL=postgres://postgres:postgres@postgres:5432/tasks?sslmode=disable
REDIS_ADDR=redis:6379
STORAGE_ROOT=/data/storage
SCRATCH_ROOT=/scratch
SIRIL_BIN=siril-cli
INTERNAL_TOKEN=replace-with-a-long-random-token
JWT_KEYS_DIR=/secrets
JWT_ISSUER=distributed-task-processor
JWT_AUDIENCE=distributed-task-processor
JWKS_URL=http://auth:8082/internal/jwks
AUTH_UPSTREAMS=http://auth:8082
TASKS_UPSTREAMS=http://tasks:8081
EVENTS_UPSTREAMS=http://events:8083
TASKS_INTERNAL_URL=http://tasks:8081
COOKIE_SECURE=false
ALLOW_REGISTRATION=false

# Optional local seed user; auth creates it only when both values are set.
SEED_USERNAME=
SEED_PASSWORD=

ASYNQ_CONCURRENCY=1
LOG_LEVEL=info
